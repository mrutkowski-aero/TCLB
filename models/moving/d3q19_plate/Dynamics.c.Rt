<?R
	source("conf.R")
        c_header();
?>
/*  Dynamics for d3q19                                         */
/*                                                             */
/*-------------------------------------------------------------*/

<?R
	source("lib/d3q19.R")

	Flow = d3q19_MRT("rho", c("Jx","Jy","Jz"), "R", group="f")

	f = Flow$f
	rho = Flow$rho
	J   = Flow$J
    Req = Flow$Req
    U   = Flow$U
    R   = Flow$R
	selR= Flow$selR

	X = U[,1]
	Y = U[,2]
	Z = U[,3]

    renum = c(19, 1, 2, 3, 4, 5, 6, 7, 11, 8, 12, 9, 13, 10, 14, 15, 17, 16, 18)
    I = rep(0, 19)
    I[renum] = 1:19
?>

<?R Inlet = function() { ?>
	Nxy = (<?R C(sum(f[X == 0 & Y > 0]) - sum(f[X == 0 & Y < 0])) ?>)/2.;
	Nxz = (<?R C(sum(f[X == 0 & Z > 0]) - sum(f[X == 0 & Z < 0])) ?>)/2.;

	f<?%d -1 + I[ 1] ?> = f<?%d -1 + I[ 2] ?> + rho * ux / 3.;
	f<?%d -1 + I[ 8] ?> = f<?%d -1 + I[11] ?> + rho * ux / 6. + Nxy;
	f<?%d -1 + I[ 7] ?> = f<?%d -1 + I[12] ?> + rho * ux / 6. - Nxy;
	f<?%d -1 + I[ 9] ?> = f<?%d -1 + I[14] ?> + rho * ux / 6. - Nxz;
	f<?%d -1 + I[10] ?> = f<?%d -1 + I[13] ?> + rho * ux / 6. + Nxz;
<?R } ?>

<?R Outlet = function() { ?>
	Nxy = (<?R C(sum(f[X == 0 & Y > 0]) - sum(f[X == 0 & Y < 0])) ?>)/2;
	Nxz = (<?R C(sum(f[X == 0 & Z > 0]) - sum(f[X == 0 & Z < 0])) ?>)/2;

	f<?%d -1 + I[ 2] ?> = f<?%d -1 + I[ 1] ?> - rho * ux / 3.0;
	f<?%d -1 + I[11] ?> = f<?%d -1 + I[ 8] ?> - rho * ux / 6.0 - Nxy;
	f<?%d -1 + I[12] ?> = f<?%d -1 + I[ 7] ?> - rho * ux / 6.0 + Nxy;
	f<?%d -1 + I[14] ?> = f<?%d -1 + I[ 9] ?> - rho * ux / 6.0 + Nxz;
	f<?%d -1 + I[13] ?> = f<?%d -1 + I[10] ?> - rho * ux / 6.0 - Nxz;
<?R } ?>

CudaDeviceFunction real_t getRho(){
	return <?R C(sum(f)) ?>;
}

CudaDeviceFunction vector_t getU(){
	real_t d = getRho();
	vector_t u;
<?R C(PV(c("u.x","u.y", "u.z")), f %*% U) ?>
	u.x /= d;
	u.y /= d;
	u.z /= d;
	if ((NodeType & NODE_BOUNDARY) == NODE_Wall) u.x = u.y = u.z = 0;
	return u;
}

CudaDeviceFunction real_t getSolid(){
    real_t MX = X - PX;// + OX;
    real_t MY = Y - PY;// + OY;
    real_t MZ = Z - PZ;// + OZ;
    real_t Xx, Yx, Zx, Xy, Yy, Zy, Xz, Yz, Zz, MXt, MYt, MZt;
    
<?R
    sinalpha = PV("sin(RALPHA)"); sinbeta = PV("sin(RBETA)"); singamma = PV("sin(RGAMMA)")
    cosalpha = PV("cos(RALPHA)"); cosbeta = PV("cos(RBETA)"); cosgamma = PV("cos(RGAMMA)")
    RZY = V(1.,0.,0.,0.,cosalpha,1.*sinalpha,0.,-1.*sinalpha,cosalpha)
    RXZ = V(cosbeta,0.,1.*sinbeta,0.,1.,0.,-1*sinbeta,0.,cosbeta)
    RYX = V(cosgamma, -1.*singamma, 0., 1.*singamma, cosgamma, 0., 0., 0., 1.)
    
    dim(RZY) = c(3,3); dim(RXZ) = c(3,3); dim(RYX) = c(3,3)

    MR = PV(c("MX","MY","MZ"))
    RX = PV(c("Xx","Yx","Zx"))
    RY = PV(c("Xy","Yy","Zy"))
    RZ = PV(c("Xz","Yz","Zz"))
    
    C(RX, RZY %*% MR)
    C(RY, RXZ %*% RX)
    C(RZ, RYX %*% RY)
?>

    real_t w = calcW(Xz, Yz, Zz);
	return w;


}

CudaDeviceFunction float2 Color() {
        float2 ret;
        vector_t u = getU();
        ret.x = sqrt(u.x*u.x + u.y*u.y + u.z*u.z);
        if ((NodeType & NODE_BOUNDARY) == NODE_Wall){
                ret.y = 0;
        } else {
                ret.y = 1;
        }
        return ret;
}

CudaDeviceFunction real_t calcW0(real_t c) {
	real_t d;
	d = c + SM_M;
	if (SM == 0) {
		if (d < 0) return 0;
		return 1;
	} else {
		d = d / SM;
		if (d < -1) return 0;
		if (d > 1) return 1;
                if (EPSF == 0) return (0.5 * (d + 1));	
		else return (((3-d*d)*d+2)/4);
	}
}

CudaDeviceFunction real_t calcW(real_t dx, real_t dy, real_t dz) {
	real_t ret = 1;
    
    ret = ret*calcW0(PDX - 2*(OX - dx));
    ret = ret*calcW0(PDX + 2*(OX - dx));
    ret = ret*calcW0(PDY - 2*(OY - dy));
    ret = ret*calcW0(PDY + 2*(OY - dy));
    ret = ret*calcW0(PDZ - 2*(OZ - dz));
    ret = ret*calcW0(PDZ + 2*(OZ - dz));
	
    return ret;
}

CudaDeviceFunction void BounceBack()
{
     real_t uf;
<?R
	uf = PV("uf")
	by(Density, Density$group, function(d) {
		i = order(d$dx,d$dy,d$dz)
		j = order(-d$dx,-d$dy,-d$dz)
		if (any(d[i,c("dx","dy","dz")]!=-d[j,c("dx","dy","dz")])) stop("Density directions are not fully symetric!");
		V = cbind(i,j);
		sel = V[,1] > V[,2]
		V = V[sel,, drop=F]
		if (nrow(V) > 0) {
		f = PV(d$name)
		apply(V,1,function(x) {
			C(uf,f[x[1]])
			C(f[x[1]],f[x[2]])
			C(f[x[2]],uf)
		})
		}
        NULL})
?>
}

CudaDeviceFunction void WVelocity()
{
    real_t rho, Nxy, Nxz;
	real_t ux = Velocity;

<?R
	C(rho, sum(f[X <  0]),float=F)
	C(rho, sum(f[X == 0]) + 2 * rho, float=F)
?>
	rho = rho / (1. - ux);

<?R 
    Inlet();
?>
}

CudaDeviceFunction void EPressure()
{
     real_t rho = Density;
     real_t Nxy, Nxz;
     real_t ux;
<?R
	ux = PV("ux")
	C(ux, sum(f[X >  0]),float=F)
	C(ux, sum(f[X == 0]) + 2 * ux, float=F)
?>
	ux =  -1. + ux / rho;


<?R 
    Outlet();
?>
}

CudaDeviceFunction void Run() {
//	printf("Run %d %d -> (%d,%d)\n", CudaBlock.x, CudaBlock.y, X, Y);

    switch (NodeType & NODE_BOUNDARY) {
	case NODE_WVelocity:
		WVelocity();
		break;
	case NODE_EPressure:
		EPressure();
		break;
	case NODE_Solid:
	case NODE_Wall:
		BounceBack();
		break;
    }
    switch (NodeType & NODE_COLLISION) {
	case NODE_MRT:
		CollisionMRT();
		break;
    }
}

CudaDeviceFunction void SetEquilibrum(real_t rho, real_t Jx, real_t Jy, real_t Jz)
{
	<?R
		C(f, Req %*% MRTMAT.inv);
	?>
}

CudaDeviceFunction void Init() {
	SetEquilibrum(1.0, Velocity, 0., 0.);
}

CudaDeviceFunction void CollisionMRT()
{
	real_t <?R C(R, sep=", ") ?>;
        #define S1 0.0
        #define S2 omega
        #define S3 omega
        #define S4 0.0
        #define S5 omega
        #define S6 0.0
        #define S7 omega
        #define S8 0.0
        #define S9 omega
        #define S10 omega
        #define S11 omega
        #define S12 omega
        #define S13 omega
        #define S14 omega
        #define S15 omega
        #define S16 omega
        #define S17 omega
        #define S18 omega
        #define S19 omega
        real_t gamma1 = 1 - omega;
        real_t gamma2 = 1 - 8.0 * ( 2.0 - omega )/( 8.0 - omega );
<?R
	S = PV("S",1:19);
	S[c(1,4,6,8)] = 0;
	S[c(2,3,10:16)] = PV("gamma1");
	S[c(5,7,9,17:19)] = PV("gamma2");
	C(R, f %*% MRTMAT);
	C(R[selR], (S*(R-Req))[selR]);
?>

    real_t w = getSolid();
    real_t ux = Jx / rho;
    real_t uy = Jy / rho;
    real_t uz = Jz / rho;
    real_t Vx = 0;
    real_t Vy = 0;
    real_t Vz = 0;
    real_t d = getRho();
    
    real_t Fx = 0.0; 
    real_t Fy = 0.0; 
    real_t Fz = 0.0; 
    
    Fx = 2*w*(Vx*d - ux);
    Fy = 2*w*(Vy*d - uy);
    Fz = 2*w*(Vz*d - uz);

    Jx += rho*(ForceX + Fx);
    Jy += rho*(ForceY + Fy);
    Jz += rho*(ForceZ + Fz);
<?R
	C(R[selR], (R + Req)[selR]);
	# nearly ortogonal MRT matrix
    Mw = colSums(MRTMAT**2)
	C(R,  Mw, eq="/=")
	C( f, R %*% t(MRTMAT) , float=F);
?>  

AddToVolumeW(w);
}
