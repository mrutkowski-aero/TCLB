CudaDeviceFunction real_t getRhoB(){
        return <?R C(sum(PV(DensityAD$name[DensityAD$group == "f"]))) ?>;
}

CudaDeviceFunction vector_t getUB(){
        vector_t u;
	<?R C(PV(c("u.x","u.y", "u.z")) == PV(DensityAD$name[DensityAD$group == "f"]) %% U) ?>;
	return u;
}

